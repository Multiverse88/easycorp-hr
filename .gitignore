/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ─── Testing ─────────────────────────────────────────────────
/coverage

# ─── Next.js ─────────────────────────────────────────────────
/.next/
/out/

# ─── Production build ────────────────────────────────────────
/build

# ─── Misc ────────────────────────────────────────────────────
.DS_Store
*.pem

# ─── Debug logs ──────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment variables ───────────────────────────────────
.env
.env.*
.env*.local
!.env.example

# ─── Vercel ──────────────────────────────────────────────────
.vercel

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── AI Tooling (local only, tidak relevan untuk tim) ────────
.mcp.json
skills-lock.json
/.openclaude/
/.superpowers/
/.agents/skills/
/.codex/
/.dsc_cache/

# ─── AI session logs & temp markdown exports ─────────────────
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.md

# ─── Temp & Scanned Material (WPT PDF, OCR, Excel, Word) ─────
/Lembar Soal WPT*
/Logo-EASYLEGAL*
/Screenshot*
/WPT_EasyLegal_Assessment*
/extracted_pdf_images/
/sheet_*.txt
*.xlsx
*.docx

# ─── Local uploads ───────────────────────────────────────────
/public/uploads/*
!/public/uploads/.gitkeep

# ─── Scratch / eksperimen lokal ──────────────────────────────
/scratch/*
!/scratch/check_db.js
!/scratch/docx_texts.json
!/scratch/parse_docx.js

# ─── Temporary root files ────────────────────────────────────
/photo_*
/*.html
/Analisis_HR_RIZQI_Staff Legal.pdf

